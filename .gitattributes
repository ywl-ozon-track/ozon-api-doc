# ============================================================
# GitHub Linguist 仓库语言统计精细化控制 (.gitattributes)
# ============================================================

# 1. 显式解除对 .vitepress (点开头目录) 的默认忽略规则
docs/.vitepress/** linguist-vendored=false
docs/.vitepress/** linguist-generated=false
docs/.vitepress/** linguist-documentation=false

# 2. 将超大上游数据源与离线产物标记为 Vendored / Generated (不占用语言比例)
specs/** linguist-vendored=true
docs/public/** linguist-vendored=true
docs/.vitepress/sidebar-*.json linguist-generated=true
docs/.vitepress/dist/** linguist-vendored=true
docs/.vitepress/cache/** linguist-vendored=true
package-lock.json linguist-generated=true

# 3. 批量生成的数千个接口详情页标记为文档类 (防止单一 Markdown 垄断 99% 比例)
docs/seller/** linguist-documentation=true
docs/performance/** linguist-documentation=true
docs/ru/seller/** linguist-documentation=true
docs/ru/performance/** linguist-documentation=true
docs/en/seller/** linguist-documentation=true
docs/en/performance/** linguist-documentation=true

# 4. 显式开启核心技术文档参与语言统计 (Markdown)
README.md linguist-detectable=true
docs/index.md linguist-detectable=true
docs/changelog.md linguist-detectable=true
docs/ru/index.md linguist-detectable=true
docs/ru/changelog.md linguist-detectable=true
docs/en/index.md linguist-detectable=true
docs/en/changelog.md linguist-detectable=true
docs/seller/index.md linguist-detectable=true
docs/performance/index.md linguist-detectable=true
docs/ru/seller/index.md linguist-detectable=true
docs/ru/performance/index.md linguist-detectable=true
docs/en/seller/index.md linguist-detectable=true
docs/en/performance/index.md linguist-detectable=true

# 5. 前端核心技术栈显式开启统计并指定语言
*.vue linguist-detectable=true
*.ts linguist-detectable=true
*.mts linguist-detectable=true
*.css linguist-detectable=true
*.mjs linguist-detectable=true
*.py linguist-detectable=true

docs/.vitepress/theme/components/*.vue linguist-language=Vue
docs/.vitepress/theme/*.ts linguist-language=TypeScript
docs/.vitepress/config.mts linguist-language=TypeScript
docs/.vitepress/theme/*.css linguist-language=CSS
